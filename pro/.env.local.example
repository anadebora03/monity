# Mesmo projeto Supabase do Monity App (ver js/config.js na raiz
# do repositório) — um backend só, dois frontends. Copie este arquivo
# para .env.local e preencha com os mesmos valores.
NEXT_PUBLIC_SUPABASE_URL=https://bbhvtrpkdltjwjyskjli.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sprint Integração Eduzz — NUNCA committar valores reais destas duas.
# service_role: Supabase Dashboard > Project Settings > API > service_role.
# Usada só em pro/lib/supabase/service.ts (rota de webhook), nunca no
# browser — é o que permite achar/criar usuário sem sessão logada.
SUPABASE_SERVICE_ROLE_KEY=
# Chave de assinatura configurada no painel de Webhooks da Eduzz
# (developers.eduzz.com/docs/webhook/security) — usada pra validar
# o cabeçalho x-signature em pro/lib/eduzz/signature.ts.
EDUZZ_WEBHOOK_SECRET=
