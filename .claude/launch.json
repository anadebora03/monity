{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "5173", "."],
      "port": 5173
    },
    {
      "name": "landing-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "landing", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "pro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "pro", "run", "dev", "--", "-p", "3001"],
      "port": 3001,
      "autoPort": true
    }
  ]
}
